# Copy to local.env.ps1 and edit, then:  . .\local.env.ps1
# $MyInvocation is used instead of $PSScriptRoot because this file is dot-sourced.
$here = Split-Path -Parent $MyInvocation.MyCommand.Path
$axisVela = Split-Path -Parent (Split-Path -Parent (Split-Path -Parent $here))
$env:PRAXOVELA_DIR = Join-Path $axisVela "PRAXOVELA"
