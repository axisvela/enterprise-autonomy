# Copy to local.env.ps1 and edit. All values are local dev settings.
#   . .\local.env.ps1

# Sibling checkouts
$env:AXISROBO_HOME = (Resolve-Path "$PSScriptRoot\..\..\..").Path
$env:AEGIVELA_DIR  = Join-Path $env:AXISROBO_HOME "Aegivela"
$env:RHEOVELA_DIR  = Join-Path $env:AXISROBO_HOME "Rheovela"
$env:PRAXOVELA_DIR = Join-Path $env:AXISROBO_HOME "PRAXOVELA"

# Local PostgreSQL (Apache AGE must be available on this server)
$env:FP1_ADMIN_DSN = "postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable"
$env:AEGIVELA_DB   = "aegivela_dev"

# Ports
$env:AEGIVELA_ADDR   = ":1886"
$env:RHEOVELA_ADDR   = ":8080"
$env:AXOND_PORT      = "1867"

# Dev credentials (local only; never commit real values)
$env:AEGIVELA_INTERNAL_AUTH_TOKEN = "dev-internal-token"
$env:AXON_API_KEY                 = "dev-key"

# Workload identity asserted by axond and bound in AEGIVELA
$env:WORKLOAD_TENANT  = "tenant-dev"
$env:WORKLOAD_SUBJECT = "axond-dev-subject"
$env:WORKLOAD_ORG     = "did:axisrobo:dev"
$env:WORKLOAD_CLIENT  = "axond-dev"
$env:WORKLOAD_REF     = "axond"

# Issuers (dev values; the same strings must be used on both sides)
$env:AEGIVELA_ISSUER = "https://aegivela-dev.local"
$env:RHEOVELA_AUDIENCE = "rheovela"

# Workflow published to Rheovela for the E2E (an example from the Rheovela checkout)
$env:WORKFLOW_FILE = Join-Path $env:RHEOVELA_DIR "examples\expense.json"
$env:WORKFLOW_ID   = "expense"
